<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <!--
        1 миграция - создание таблицы weather_requests
    -->
    <changeSet id="create_weather_requests_table" author="dariaabrosimovaa">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="weather_requests"/>
            </not>
        </preConditions>
        <createTable tableName="weather_requests">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="city" type="VARCHAR(255)"/>
            <column name="request_type" type="VARCHAR(50)"/>
            <column name="latitude" type="DOUBLE PRECISION"/>
            <column name="longitude" type="DOUBLE PRECISION"/>
            <column name="forecast_days" type="INTEGER"/>
            <column name="start_date" type="VARCHAR(20)"/>
            <column name="end_date" type="VARCHAR(20)"/>
            <column name="request_time" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <!--
        2 миграция - индекс по городу
    -->
    <changeSet id="add_city_index" author="dariaabrosimovaa">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_city"/>
            </not>
        </preConditions>
        <createIndex tableName="weather_requests" indexName="idx_city">
            <column name="city"/>
        </createIndex>
    </changeSet>

    <!--
        3 миграция - индекс по времени запроса
    -->
    <changeSet id="add_request_time_index" author="dariaabrosimovaa">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_request_time"/>
            </not>
        </preConditions>
        <createIndex tableName="weather_requests" indexName="idx_request_time">
            <column name="request_time"/>
        </createIndex>
    </changeSet>

    <!--
        4 миграция - таблица погодных предупреждений
    -->
    <changeSet id="create_weather_alerts_table" author="dariaabrosimovaa">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="weather_alerts"/>
            </not>
        </preConditions>
        <createTable tableName="weather_alerts">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="city" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="message" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="alert_date" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

        <createIndex tableName="weather_alerts" indexName="idx_alert_city">
            <column name="city"/>
        </createIndex>

        <createIndex tableName="weather_alerts" indexName="idx_alert_date">
            <column name="alert_date"/>
        </createIndex>
    </changeSet>

    <!--
        5 миграция - таблица API ключей
    -->
    <changeSet id="create_api_keys_table" author="dariaabrosimovaa">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="api_keys"/>
            </not>
        </preConditions>
        <createTable tableName="api_keys">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="key_value" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="subscription_level" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true"/>
        </createTable>

        <createIndex tableName="api_keys" indexName="idx_api_key_value">
            <column name="key_value"/>
        </createIndex>
    </changeSet>

    <!--
        6 миграция - таблица с популярными запросами (для отслеживания статистики)
    -->

    <changeSet id="create_popular_searches_table" author="dariaabrosimovaa">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="city_stats"/>
            </not>
        </preConditions>
        <createTable tableName="popular_searches">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="city" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="request_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="search_count" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="last_searched" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

        <createIndex tableName="popular_searches" indexName="idx_popular_city_type" unique="true">
            <column name="city"/>
            <column name="request_type"/>
        </createIndex>

        <createIndex tableName="popular_searches" indexName="idx_popular_count">
            <column name="search_count"/>
        </createIndex>
    </changeSet>

    <!--
        7 миграция - добавление колонки api_key ы таблицу weather_requests
    -->
    <changeSet id="add_api_key_to_weather_requests" author="dariaabrosimovaa">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="weather_requests" columnName="api_key"/>
            </not>
        </preConditions>
        <addColumn tableName="weather_requests">
            <column name="api_key" type="VARCHAR(255)"/>
        </addColumn>

        <createIndex tableName="weather_requests" indexName="idx_weather_requests_api_key">
            <column name="api_key"/>
        </createIndex>
    </changeSet>

    <!--
        8 миграция - создание таблицы users
    -->
    <changeSet id="create_users_table" author="dariaabrosimovaa">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="users"/>
            </not>
        </preConditions>
        <createTable tableName="users">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="password" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="api_key" type="VARCHAR(255)">
                <constraints unique="true"/>
            </column>
            <column name="subscription_level" type="VARCHAR(50)"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true"/>
        </createTable>
    </changeSet>
</databaseChangeLog>