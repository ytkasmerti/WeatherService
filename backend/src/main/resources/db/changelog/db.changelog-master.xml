<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <!--
        1 миграция - создание таблицы weather_requests
    -->
    <changeSet id="create_weather_requests_table" author="dariaabrosimovaa">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="weather_requests"/>
            </not>
        </preConditions>
        <createTable tableName="weather_requests">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="city" type="VARCHAR(255)"/>
            <column name="request_type" type="VARCHAR(50)"/>
            <column name="latitude" type="DOUBLE PRECISION"/>
            <column name="longitude" type="DOUBLE PRECISION"/>
            <column name="forecast_days" type="INTEGER"/>
            <column name="start_date" type="VARCHAR(20)"/>
            <column name="end_date" type="VARCHAR(20)"/>
            <column name="request_time" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <!--
        2 миграция - индекс по городу
    -->
    <changeSet id="add_city_index" author="dariaabrosimovaa">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_city"/>
            </not>
        </preConditions>
        <createIndex tableName="weather_requests" indexName="idx_city">
            <column name="city"/>
        </createIndex>
    </changeSet>

    <!--
        3 миграция - индекс по времени запроса
    -->
    <changeSet id="add_request_time_index" author="dariaabrosimovaa">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_request_time"/>
            </not>
        </preConditions>
        <createIndex tableName="weather_requests" indexName="idx_request_time">
            <column name="request_time"/>
        </createIndex>
    </changeSet>

    <!--
        4 миграция - таблица погодных предупреждений
    -->
    <changeSet id="create_weather_alerts_table" author="dariaabrosimovaa">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="weather_alerts"/>
            </not>
        </preConditions>
        <createTable tableName="weather_alerts">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="city" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="message" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="alert_date" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

        <createIndex tableName="weather_alerts" indexName="idx_alert_city">
            <column name="city"/>
        </createIndex>

        <createIndex tableName="weather_alerts" indexName="idx_alert_date">
            <column name="alert_date"/>
        </createIndex>
    </changeSet>

    <!--
        5 миграция - таблица API ключей
    -->
    <changeSet id="create_api_keys_table" author="dariaabrosimovaa">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="api_keys"/>
            </not>
        </preConditions>
        <createTable tableName="api_keys">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="key_value" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="subscription_level" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true"/>
        </createTable>

        <createIndex tableName="api_keys" indexName="idx_api_key_value">
            <column name="key_value"/>
        </createIndex>
    </changeSet>

    <!--
        6 миграция - таблица с популярными запросами (для отслеживания статистики)
    -->

    <changeSet id="create_popular_searches_table" author="dariaabrosimovaa">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="city_stats"/>
            </not>
        </preConditions>
        <createTable tableName="popular_searches">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="city" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="request_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="search_count" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="last_searched" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

        <createIndex tableName="popular_searches" indexName="idx_popular_city_type" unique="true">
            <column name="city"/>
            <column name="request_type"/>
        </createIndex>

        <createIndex tableName="popular_searches" indexName="idx_popular_count">
            <column name="search_count"/>
        </createIndex>
    </changeSet>

    <!--
        7 миграция - добавление колонки api_key ы таблицу weather_requests
    -->
    <changeSet id="add_api_key_to_weather_requests" author="dariaabrosimovaa">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="weather_requests" columnName="api_key"/>
            </not>
        </preConditions>
        <addColumn tableName="weather_requests">
            <column name="api_key" type="VARCHAR(255)"/>
        </addColumn>

        <createIndex tableName="weather_requests" indexName="idx_weather_requests_api_key">
            <column name="api_key"/>
        </createIndex>
    </changeSet>

    <!--
        8 миграция - создание таблицы users
    -->
    <changeSet id="create_users_table" author="dariaabrosimovaa">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="users"/>
            </not>
        </preConditions>
        <createTable tableName="users">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="password" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="api_key" type="VARCHAR(255)">
                <constraints unique="true"/>
            </column>
            <column name="subscription_level" type="VARCHAR(50)"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true"/>
        </createTable>
    </changeSet>

    <!--
        9 миграция - добавление колонки auto_renewal в таблицу users
    -->
    <changeSet id="add_auto_renewal_to_users" author="dariaabrosimovaa">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="users" columnName="auto_renewal"/>
            </not>
        </preConditions>
        <addColumn tableName="users">
            <column name="auto_renewal" type="BOOLEAN" defaultValueBoolean="false"/>
        </addColumn>
    </changeSet>

    <!--
        10 миграция - добавление колонки subscription_expires_at в таблицу users
    -->
    <changeSet id="add_subscription_expires_at_to_users" author="dariaabrosimovaa">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="users" columnName="subscription_expires_at"/>
            </not>
        </preConditions>
        <addColumn tableName="users">
            <column name="subscription_expires_at" type="TIMESTAMP"/>
        </addColumn>
    </changeSet>

    <!--
        11 миграция - создание таблицы payments
    -->
    <changeSet id="create_payments_table" author="dariaabrosimovaa">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="payments"/>
            </not>
        </preConditions>
        <createTable tableName="payments">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="payment_id" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="api_key" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="level" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="INTEGER"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="confirmed_at" type="TIMESTAMP"/>
            <column name="is_confirmed" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="status" type="VARCHAR(50)" defaultValue="PENDING"/>
        </createTable>

        <createIndex tableName="payments" indexName="idx_payment_api_key">
            <column name="api_key"/>
        </createIndex>

        <createIndex tableName="payments" indexName="idx_payment_payment_id">
            <column name="payment_id"/>
        </createIndex>
    </changeSet>

    <!--
        12 миграция - создание таблицы password_reset_codes
    -->
    <changeSet id="add_password_reset_codes_table" author="ytkasmerti">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="password_reset_codes"/>
            </not>
        </preConditions>
        <createTable tableName="password_reset_codes">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="email" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="code" type="varchar(10)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="password_reset_codes" indexName="idx_reset_codes_email">
            <column name="email"/>
        </createIndex>

        <createIndex tableName="password_reset_codes" indexName="idx_reset_codes_expires">
            <column name="expires_at"/>
        </createIndex>
    </changeSet>

    <!--
        13 миграция - добавление колонки expires_at в таблицу payments
    -->
    <changeSet id="add_expires_at_to_payments" author="ytkasmerti">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="payments" columnName="expires_at"/>
            </not>
        </preConditions>
        <addColumn tableName="payments">
            <column name="expires_at" type="TIMESTAMP"/>
        </addColumn>
    </changeSet>

    <!--
        14 миграция - добавление user_id в таблицу payments
    -->
    <changeSet id="add_user_id_to_payments" author="ytkasmerti">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="payments" columnName="user_id"/>
            </not>
        </preConditions>

        <addColumn tableName="payments">
            <column name="user_id" type="BIGINT"/>
        </addColumn>

        <sql>
            UPDATE payments p
            SET user_id = (SELECT id FROM users u WHERE u.email = p.email)
            WHERE p.user_id IS NULL
        </sql>

        <addNotNullConstraint tableName="payments" columnName="user_id"/>
        <addForeignKeyConstraint
                baseTableName="payments"
                baseColumnNames="user_id"
                referencedTableName="users"
                referencedColumnNames="id"
                constraintName="fk_payments_user_id"/>

        <dropColumn tableName="payments" columnName="email"/>
    </changeSet>

    <!--
        15 миграция: создание таблицы user_subscriptions
    -->
    <changeSet id="create_user_subscriptions_table" author="ytkasmerti">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="user_subscriptions"/>
            </not>
        </preConditions>
        <createTable tableName="user_subscriptions">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_user_subscriptions_user" references="users(id)"/>
            </column>
            <column name="city" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="notify_heat" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="notify_cold" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="notify_wind" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="notify_precip" type="BOOLEAN" defaultValueBoolean="false"/>
        </createTable>
    </changeSet>

    <!--
        16 миграция - добавление user_id в таблицу user_subscriptions
    -->
    <changeSet id="add_user_id_to_user_subscriptions" author="ytkasmerti">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="user_subscriptions" columnName="user_id"/>
            </not>
        </preConditions>

        <addColumn tableName="user_subscriptions">
            <column name="user_id" type="BIGINT"/>
        </addColumn>

        <sql>
            UPDATE user_subscriptions us
            SET user_id = (SELECT id FROM users u WHERE u.email = us.email)
            WHERE us.user_id IS NULL
        </sql>

        <addNotNullConstraint tableName="user_subscriptions" columnName="user_id"/>

        <addForeignKeyConstraint
                baseTableName="user_subscriptions"
                baseColumnNames="user_id"
                referencedTableName="users"
                referencedColumnNames="id"
                constraintName="fk_user_subscriptions_user_id"/>

        <dropColumn tableName="user_subscriptions" columnName="email"/>
    </changeSet>

    <!--
        17 миграция - удаление таблицы api_keys
    -->
    <changeSet id="drop_api_keys_table" author="ytkasmerti">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="api_keys"/>
        </preConditions>
        <dropTable tableName="api_keys"/>
    </changeSet>

    <!--
        18 миграция - удаление таблицы weather_alerts
    -->
    <changeSet id="drop_weather_alerts_table" author="ytkasmerti">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="weather_alerts"/>
        </preConditions>
        <dropTable tableName="weather_alerts"/>
    </changeSet>

