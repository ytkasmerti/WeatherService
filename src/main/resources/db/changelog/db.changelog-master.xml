<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <!--
        1 миграция - создание таблицы weather_requests
    -->
    <changeSet id="1" author="dariaabrosimovaa">
        <createTable tableName="weather_requests">

            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="city" type="VARCHAR(255)"/>

            <column name="request_type" type="VARCHAR(50)"/>

            <column name="latitude" type="DOUBLE"/>

            <column name="longitude" type="DOUBLE"/>

            <column name="forecast_days" type="INT"/>

            <column name="start_date" type="VARCHAR(20)"/>

            <column name="end_date" type="VARCHAR(20)"/>

            <column name="request_time" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <!--
        2 миграция - индекс по городу
    -->
    <changeSet id="2" author="dariaabrosimovaa">
        <createIndex tableName="weather_requests" indexName="idx_city">
            <column name="city"/>
        </createIndex>
    </changeSet>

    <!--
        3 миграция - индекс по времени
    -->
    <changeSet id="3" author="dariaabrosimovaa">
        <createIndex tableName="weather_requests" indexName="idx_request_time">
            <column name="request_time"/>
        </createIndex>
    </changeSet>

    <!--
        4 миграция - таблица погодных предупреждений
    -->
    <changeSet id="4" author="dariaabrosimovaa">
        <createTable tableName="weather_alerts">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="city" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="message" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="alert_date" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

        <createIndex tableName="weather_alerts" indexName="idx_alert_city">
            <column name="city"/>
        </createIndex>

        <createIndex tableName="weather_alerts" indexName="idx_alert_date">
            <column name="alert_date"/>
        </createIndex>
    </changeSet>

    <!--
        5 миграция - таблица API ключей
    -->
    <changeSet id="5" author="dariaabrosimovaa">
        <createTable tableName="api_keys">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="key_value" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="subscription_level" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true"/>
        </createTable>

        <createIndex tableName="api_keys" indexName="idx_api_key_value">
            <column name="key_value"/>
        </createIndex>
        
    </changeSet>

    <!--
        6 миграция - таблица с кэшированными погодными данными (для Redis)
    -->
    <changeSet id="create_weather_cache_table" author="dariaabrosimovaa">
        <createTable tableName="weather_cache">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="cache_key" type="VARCHAR(500)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="response_data" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="request_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="location" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

        <createIndex tableName="weather_cache" indexName="idx_cache_key">
            <column name="cache_key"/>
        </createIndex>

        <createIndex tableName="weather_cache" indexName="idx_cache_expires">
            <column name="expires_at"/>
        </createIndex>

        <createIndex tableName="weather_cache" indexName="idx_cache_location_type">
            <column name="location"/>
            <column name="request_type"/>
        </createIndex>
    </changeSet>

    <!--
        
    -->

    <changeSet id="create_popular_searches_table" author="dariaabrosimovaa">
        <createTable tableName="popular_searches">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="city" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="request_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="search_count" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="last_searched" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

        <createIndex tableName="popular_searches" indexName="idx_popular_city_type" unique="true">
            <column name="city"/>
            <column name="request_type"/>
        </createIndex>

        <createIndex tableName="popular_searches" indexName="idx_popular_count">
            <column name="search_count"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>